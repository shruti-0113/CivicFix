# CivicFix — environment configuration
#
# Copy this file to `.env` (already git-ignored) and fill in what you need:
#     cp .env.example .env        # macOS / Linux
#     copy .env.example .env      # Windows
#
# Real environment variables always take precedence over this file, so a hosting
# platform (Render, PythonAnywhere, Docker) can override anything set locally.
# Everything is optional — the app runs with zero configuration.


# --------------------------------------------------------------------------- #
# Google Maps Platform
# --------------------------------------------------------------------------- #
# Enable these APIs in Google Cloud: Maps JavaScript API, Geocoding API,
# Places API (New) and Directions API.
# Leave it empty to use the free OpenStreetMap fallback (no key, no billing).
GOOGLE_MAPS_API_KEY=


# --------------------------------------------------------------------------- #
# Community fund
# --------------------------------------------------------------------------- #
# Your UPI ID for direct "Pay via UPI" contribution links, e.g. yourname@okhdfcbank
UPI_ID=


# --------------------------------------------------------------------------- #
# AI / LLM
# --------------------------------------------------------------------------- #
# auto | openai | gemini | anthropic | groq | custom
# "auto" uses the first provider that has a key below.
AI_PROVIDER=auto

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible server (OpenRouter, LM Studio, Ollama, vLLM, ...)
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1


# --------------------------------------------------------------------------- #
# Server
# --------------------------------------------------------------------------- #
PORT=5000
# Debug mode is on by default for local development (auto-reload).
# ALWAYS set FLASK_DEBUG=0 on a public host — the debugger must never be exposed.
# FLASK_DEBUG=1
